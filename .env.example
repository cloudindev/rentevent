# ─── Rentevent · variables de entorno ───────────────────────────────
# Todo arranca en local SIN claves: cada servicio externo tiene modo simulado.

# Base de datos (PostgreSQL). En Supabase usa el pooler de transacciones (puerto 6543).
DATABASE_URL=postgres://localhost:5432/rentevent
# Opcional: base de datos para tests de integración
TEST_DATABASE_URL=postgres://localhost:5432/rentevent_test

# URL pública y dominio raíz (subdominio por empresa: empresa.ROOT_DOMAIN)
APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost:3000

# Autenticación (genera con: openssl rand -base64 32)
AUTH_SECRET=
# Secreto para /api/cron (Vercel Cron lo envía como Bearer)
CRON_SECRET=
# Secreto del webhook de correo entrante (/api/webhooks/email); si falta se usa CRON_SECRET
EMAIL_WEBHOOK_SECRET=
# Muestra credenciales demo y el buzón de pruebas (/dev/correo)
DEMO_MODE=true

# OAuth (vacío = botón desactivado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Correo (vacío = buzón simulado en /dev/correo). Ej: smtps://usuario:clave@smtp.proveedor.eu:465
SMTP_URL=
EMAIL_FROM="Rentevent <no-reply@rentevent.es>"
# Bandeja que recibe las solicitudes de demo de la web pública
SALES_EMAIL=ventas@rentevent.es

# Almacenamiento S3 compatible en la UE (vacío = archivos guardados en PostgreSQL)
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe Billing (vacío = pagos simulados)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFESIONAL=
STRIPE_PRICE_EMPRESA=
STRIPE_PRICE_BASICO_ANUAL=
STRIPE_PRICE_PROFESIONAL_ANUAL=

# Geocodificación compatible con Nominatim (vacío = nomenclátor interno)
GEOCODER_URL=

# WhatsApp Cloud API (vacío = simulado)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Asistente IA (vacío = asistente simulado basado en reglas)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Notificaciones push (genera con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@rentevent.es

# Cola de trabajos con Redis/BullMQ (vacío = cola en PostgreSQL procesada por /api/cron)
REDIS_URL=
